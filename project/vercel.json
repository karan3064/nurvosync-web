{
  "routes": [
    {
      "src": "^/(assets/.*)",
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      },
      "dest": "/assets/$1"
    },
    {
      "src": "^/(.*\\.(?:png|jpg|jpeg|gif|webp|svg|glb|ico|mp4|pdf|xlsx))$",
      "dest": "/$1"
    },
    {
      "src": ".*",
      "dest": "/index.html"
    }
  ]
}
